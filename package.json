{
  "name": "dsh-whale-combo",
  "version": "1.0.4",
  "description": "在鲸鱼娘旁显示毛玻璃拟态的状态气泡（余额 ¥ / 今日 ¥ / 缓存命中 / 峰谷，本轮在悬停提示里），并在每次计费时播放命中·输出·未命中扣费弹幕；Ctrl+Alt+D 可显示 damage-pulse 原悬浮卡。数据合并自 dsh-damage-pulse 与 dsh-whale-widget。",
  "author": "谷子Guzi",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "docs/preview.png",
    "docs/card.png",
    "docs/icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "whale",
    "balance",
    "token-monitor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guzi2005/dsh-whale-combo.git"
  },
  "homepage": "https://github.com/Guzi2005/dsh-whale-combo#readme",
  "bugs": {
    "url": "https://github.com/Guzi2005/dsh-whale-combo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
